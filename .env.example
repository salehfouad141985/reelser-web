# Required only to enable administration. Generate fresh random values.
ADMIN_JWT_SECRET=
REELSER_ADMIN_PASS=
# A persistent local volume shared by all workers (not a network filesystem).
# REELSER_DATA_DIR=/var/lib/reelser
# Set only if a trusted front proxy overwrites this header and prevents bypass.
# Otherwise all visitors intentionally share one quota.
# REELSER_TRUSTED_IP_HEADER=x-real-ip

# Self-hosted profile source (enable only after service login and health checks).
# REELSER_PROFILE_SOURCE=selfHosted
# REELSER_SOURCE_URL=http://127.0.0.1:8010
# Same random secret on the web server and source service; never NEXT_PUBLIC_.
# REELSER_SOURCE_TOKEN=
